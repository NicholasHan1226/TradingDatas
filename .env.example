# =============================================================================
# SharedSignals — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# ---- Paths (defaults point to /opt/investment) ----
INVESTMENT_ROOT=/opt/investment
SHAREDSIGNALS_ROOT=/opt/investment/SharedSignals
MARKETGRAPH_ROOT=/opt/investment/MarketGraph
MARKETGRAPH_RUNTIME_ROOT=/opt/investment/MarketGraphRuntime
ASHARE_ROOT=/opt/investment/Ashare
CRYPTO_ROOT=/opt/investment/Crypto

# ---- Data paths (override individual data directories) ----
SHAREDSIGNALS_INTAKE_ROOT=/opt/investment/SharedSignals/data/intake
SHAREDSIGNALS_REFERENCE_ROOT=/opt/investment/SharedSignals/reference
ASHARE_MONEYFLOW_ROOT=/opt/investment/SharedSignals/data/moneyflow
MACRO_FACTORS_PATH=/opt/investment/SharedSignals/data/macro_factors.csv
CRYPTO_KLINES_PATH=/opt/investment/Crypto/data/market/klines.csv
REALTIME_5M_ROOT=/opt/investment/MarketGraphRuntime/staging/tushare_rt_min_5m
STOCK_INDUSTRY_MAP_PATH=/opt/investment/SharedSignals/data/association/stock_industry_map.csv
EVENT_SIGNAL_ASSOC_PATH=/opt/investment/SharedSignals/data/association/event_signal_associations.csv
IMPACT_RELATIONS_PATH=/opt/investment/SharedSignals/data/association/impact_relations.csv
TARGET_STOCK_MAP_PATH=/opt/investment/SharedSignals/data/association/target_stock_map.csv

# ---- API Server ----
SHAREDSIGNALS_API_HOST=0.0.0.0
SHAREDSIGNALS_API_PORT=8082
SHAREDSIGNALS_API_VERSION=1.0.0

# ---- Email (Cloudflare Email Routing + SMTP fallback) ----
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
EMAIL_FROM_TRADING=notice@agentspaces.cc
EMAIL_FROM_SYSTEM=notice@tradingagent.cc
EMAIL_TO_TRADING=tradingadviser@coze.email
EMAIL_TO_SYSTEM=soc@coze.email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEADSIMPLE_URL=

# ---- Deploy ----
SHAREDSIGNALS_SERVER=8.138.181.177
SHAREDSIGNALS_SECONDARY_SERVER=47.82.153.58
SHAREDSIGNALS_VENV_PYTHON=/opt/marketgraph/venv/bin/python3

# ---- Tushare / QuickSync ----
QUICKSYNC_URL=
TUSHARE_TOKEN=
