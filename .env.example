# TradingDatas internal runtime
# Copy to a root-owned runtime environment file. Never commit real secrets.

TRADINGDATAS_DATA_ROOT=/opt/investment-data/tradingdatas
TRADINGDATAS_DB_PATH=/opt/investment-data/tradingdatas/read_model/provider_native.sqlite

# Code, registry and schedule are bound to the process's physical immutable
# release. Do not redirect them through /current or a runtime environment file.

# Internal sidecar. External/Beta ingress is deliberately out of scope.
TRADINGDATAS_API_HOST=127.0.0.1
TRADINGDATAS_API_PORT=18082
TRADINGDATAS_TOKEN_HASH_FILE=/etc/tradingdatas/api_tokens.json

# The separate root-owned /etc/tradingdatas/internal-api.env must also set:
# TRADINGDATAS_TOKEN_SALT=<secret>
# TRADINGDATAS_CURSOR_SIGNING_KEY=<secret>

# Dataset provider is Tushare; the current runtime transport service is
# QuickSync. Credentials are loaded from an exact-0600 regular file owned by
# the effective service user (the dedicated production account is `tradingdatas`).
# Do not replace this URL with api.tushare.pro for the QuickSync credential.
TUSHARE_API_URL=https://api.quicksync.cn
TUSHARE_TOKEN_FILE=/etc/tradingdatas/quicksync.token

# Bounded generic runner defaults. QuickSync rate/concurrency limits are not
# inferred from official Tushare points. Keep the timer disabled until a
# bounded canary freezes the real account budget.
TRADINGDATAS_COLLECT_LOCK=/run/lock/tradingdatas-collect.lock
TRADINGDATAS_HTTP_TIMEOUT_SECONDS=30
TRADINGDATAS_MAX_PARALLEL_REQUESTS=1
