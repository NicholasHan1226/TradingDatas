# =============================================================================
# SharedSignals — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# ---- Paths (defaults point to /opt/investment) ----
INVESTMENT_ROOT=/opt/investment
SHAREDSIGNALS_ROOT=/opt/investment/SharedSignals
SHAREDSIGNALS_REPO_DIR=/opt/investment/SharedSignals
SHAREDSIGNALS_ENV_FILE=/opt/investment/SharedSignals/.env
SHAREDSIGNALS_RUNTIME_ROOT=/opt/investment/SharedSignals/runtime
SHAREDSIGNALS_READ_MODEL_DIR=/opt/investment/SharedSignals/runtime/read_model
SHAREDSIGNALS_MARKETDATA_DB=/opt/investment/SharedSignals/runtime/read_model/marketdata.sqlite
SHAREDSIGNALS_BACKUP_DIR=/opt/investment/SharedSignals/backups
SHAREDSIGNALS_RUNTIME_BACKUP_DIR=/opt/investment/runtime-backups
SHAREDSIGNALS_DATA_MOUNT=/opt/investment-data
SHAREDSIGNALS_DATA_UUID=3f7cbf99-b15e-4c54-94cc-a57e38412874
SHAREDSIGNALS_SERVICE_MOUNT_GUARD=/etc/systemd/system/sharedsignals-api.service.d/20-finance-data-mount.conf
SHAREDSIGNALS_REQUIRE_MOUNTS=1
ASHARE_ROOT=/opt/investment/SharedSignals/collectors/tushare

# ---- Data paths ----
SHAREDSIGNALS_REFERENCE_ROOT=/opt/investment/SharedSignals/reference

# ---- API Server ----
SHAREDSIGNALS_API_HOST=0.0.0.0
SHAREDSIGNALS_API_PORT=8082
SHAREDSIGNALS_API_VERSION=1.0.0

# ---- Email (Cloudflare Email Routing + SMTP fallback) ----
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
EMAIL_FROM_TRADING=notice@tradingagent.cc
EMAIL_FROM_SYSTEM=notice@tradingagent.cc
EMAIL_TO_TRADING=tradingadviser@coze.email
EMAIL_TO_SYSTEM=soc@coze.email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEADSIMPLE_URL=

# ---- Deploy ----
SHAREDSIGNALS_SERVER=8.138.181.177
SHAREDSIGNALS_SECONDARY_SERVER=47.82.153.58
SHAREDSIGNALS_VENV_PYTHON=/opt/sharedsignals/venv/bin/python3
SHAREDSIGNALS_CSV_BRIDGE_DB_RETRIES=3
WATCHDOG_API_HEALTH_RETRIES=3

# ---- 24/7 external market proxy ----
# Use comma-separated proxy priority lists for markets that need overseas access.
# Production uses a localhost SSH tunnel to Singapore first, then local
# Mihomo/Clash fallback. Do not expose a public relay port.
POLYMARKET_HTTP_PROXIES=http://127.0.0.1:18889,http://127.0.0.1:7890
POLYMARKET_FETCH_RETRIES=3
POLYMARKET_REQUEST_TIMEOUT=25
POLYMARKET_DB_RETRIES=3
POLYMARKET_DIRECT_FALLBACK_ENABLED=0
BINANCE_HTTP_PROXIES=http://127.0.0.1:18889,http://127.0.0.1:7890

# ---- Tushare / QuickSync ----
QUICKSYNC_URL=
TUSHARE_TOKEN=
# P2 remains disabled in the cron manifests until an authorized production pilot.
SHAREDSIGNALS_P2_TIMEOUT=900
SHAREDSIGNALS_P2_DEADLINE_SECONDS=840
SHAREDSIGNALS_P2_MAX_PROVIDER_CALLS=2500
SHAREDSIGNALS_P2_MAX_ROWS_ADMITTED=100000
