[project]
sub_id = "3fff0aa2"
name = "TradingDatas"
project_type = "backend"
requires = ["python-3.12"]
version = ""

[preview]
preview_enable = "enabled"

[dev]
run = ["bash", "-c", "TRADINGDATAS_API_HOST=0.0.0.0 TRADINGDATAS_API_PORT=5000 TRADINGDATAS_TOKEN_SALT=dev-preview-salt-not-for-production-use python3 api_server.py"]

[deploy]
build = []
run = ["bash", "-c", "TRADINGDATAS_API_HOST=0.0.0.0 TRADINGDATAS_API_PORT=${PORT:-5000} python3 api_server.py"]

[subprojects]
path = ["."]
