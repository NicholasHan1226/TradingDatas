{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "tradingdatas",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-29",
  "vars": {
    "ACCOUNT_API_BASE": "https://td-admin-api.tradingagent.cc",
    "EMAIL_LOGIN_ENABLED": "true",
    "IDENTITY_RETENTION_ENABLED": "true",
    "ACCOUNT_CONNECTION_ENABLED": "false",
    "ACCOUNT_LIBRARY_ENABLED": "false",
    "ACCOUNT_ADMIN_ENABLED": "false"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "tradingdatas-identity-v1",
      "database_id": "bb5e8d90-090f-40a5-9aa1-b91b33af7199"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
