# SharedSignals — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# DeepSeek (LLM provider — analysis agents, news classification)
DEEPSEEK_API_KEY=

# Tavily (web search enrichment)
TAVILY_API_KEY=

# Firecrawl (web scraping / content extraction)
FIRECRAWL_API_KEY=

# QuickSync (internal trade-sync bridge — SharedSignals → Tradings)
QUICKSYNC_URL=

# SQLite bridge lock/busy retry guard.
SHAREDSIGNALS_CSV_BRIDGE_DB_RETRIES=3
WATCHDOG_API_HEALTH_RETRIES=3

# Overseas market proxy priority lists. Production keeps local Clash/Mihomo as
# fallback and prefers the localhost SSH tunnel to Singapore. Do not expose a
# public relay port.
POLYMARKET_HTTP_PROXIES=http://127.0.0.1:18889,http://127.0.0.1:7890
POLYMARKET_FETCH_RETRIES=3
POLYMARKET_REQUEST_TIMEOUT=25
POLYMARKET_DB_RETRIES=3
POLYMARKET_DIRECT_FALLBACK_ENABLED=0
BINANCE_HTTP_PROXIES=http://127.0.0.1:18889,http://127.0.0.1:7890
