[Unit]
Description=SharedSignals provider-native registry scheduler
Wants=network-online.target sharedsignals-v1-internal.service
After=network-online.target sharedsignals-v1-internal.service
ConditionPathIsRegular=/etc/sharedsignals/provider-native-collector.secrets
ConditionPathIsRegular=/opt/investment/releases/sharedsignals-v1/current/config/provider_native_dataset_registry.yaml

[Service]
Type=oneshot
TimeoutStartSec=900s
User=marketgraph
Group=marketgraph
WorkingDirectory=/opt/investment/releases/sharedsignals-v1/current
EnvironmentFile=/opt/investment/releases/sharedsignals-v1/current/deploy/provider_native_internal.env
EnvironmentFile=/etc/sharedsignals/provider-native-collector.secrets
ExecStart=/opt/sharedsignals/venv/bin/python3 /opt/investment/releases/sharedsignals-v1/current/tools/run_provider_native_schedule.py --execute
RuntimeDirectory=sharedsignals
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/investment-data/sharedsignals-v1 /run/sharedsignals
