[Unit]
Description=TradingDatas Crypto Binance USDM funding-rate and open-interest candidate collection
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/investment-data/tradingdatas-crypto/read_model/provider_native.sqlite

[Service]
Type=oneshot
User=tradingdatas-crypto
Group=tradingdatas-crypto
WorkingDirectory=/opt/investment/releases/tradingdatas-crypto/current
EnvironmentFile=/opt/investment/releases/tradingdatas-crypto/current/deploy/crypto/tradingdatas_crypto_internal.env
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/tradingdatas/venv/bin/python3 /opt/investment/releases/tradingdatas-crypto/current/tools/run_binance_usdm_canary.py --db-path /opt/investment-data/tradingdatas-crypto/read_model/provider_native.sqlite --lock-path /opt/investment-data/tradingdatas-crypto/collect-usdm.lock --execute
TimeoutStartSec=10min
UMask=0077
RuntimeDirectory=tradingdatas-crypto
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/investment-data/tradingdatas-crypto
StandardOutput=journal
StandardError=journal
