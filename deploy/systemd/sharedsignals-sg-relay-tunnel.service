[Unit]
Description=SharedSignals Singapore relay SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -i /root/.ssh/sharedsignals_sg_relay_ed25519 -L 127.0.0.1:18889:127.0.0.1:18888 -R 127.0.0.1:80:127.0.0.1:80 -R 127.0.0.1:8082:127.0.0.1:8082 root@47.82.153.58
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
