[Unit]
Description=SharedSignals REST API
After=network.target

[Service]
Type=simple
User=marketgraph
WorkingDirectory=/opt/investment/SharedSignals
Environment="SHAREDSIGNALS_LOCALHOST_BYPASS=1"
Environment="SHAREDSIGNALS_API_HOST=127.0.0.1"
Environment="SHAREDSIGNALS_API_PORT=8082"
Environment="PYTHONPATH=/opt/investment/SharedSignals"
EnvironmentFile=-/opt/investment/SharedSignals/.env
ExecStart=/opt/sharedsignals/venv/bin/python3 /opt/investment/SharedSignals/api_server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
